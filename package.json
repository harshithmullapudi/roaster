{
  "name": "roster",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:push": "pnpm --filter @roster/db push",
    "db:generate": "pnpm --filter @roster/db generate",
    "db:studio": "pnpm --filter @roster/db studio",
    "dev:db": "docker compose -f docker-compose.dev.yaml up -d",
    "dev:db:stop": "docker compose -f docker-compose.dev.yaml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
