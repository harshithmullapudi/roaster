# Postgres. Matches docker-compose.dev.yaml.
DATABASE_URL="postgresql://roster:roster@localhost:5442/roster"

# better-auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email. Leave RESEND_API_KEY empty in development and magic links are
# printed to the server console instead of sent — auth is then developable
# with no email account wired up.
RESEND_API_KEY=""
EMAIL_FROM="Roster <onboarding@resend.dev>"

# Centrifugo. Matches docker-compose.dev.yaml (8010 rather than 8000).
# Generate the two secrets with: openssl rand -hex 32
# Leave them empty and realtime turns itself off: sending and reading fall
# back to plain tRPC.
CENTRIFUGO_URL="http://localhost:8010"
CENTRIFUGO_API_KEY=""
CENTRIFUGO_TOKEN_HMAC_SECRET=""

# Encrypts the stored Superset API key (AES-256-GCM).
# Generate with: openssl rand -base64 32
SUPERSET_KEY_SECRET=""
SUPERSET_API_URL="https://api.superset.sh"
SUPERSET_RELAY_URL="https://relay.superset.sh"
